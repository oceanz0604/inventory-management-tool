rules_version = '2';

// Security rules for ZatPat IMS Firestore data.
// Collections mirror the localStorage entities (see .cursor/rules/ims-data-model.mdc).
// Owner-scoped docs carry an `ownerId` that must equal the signed-in user's uid.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(ownerId) { return signedIn() && request.auth.uid == ownerId; }

    // User profiles. Never store passwords here — auth is handled by Firebase Auth.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Global category catalog — readable by all signed-in users.
    match /categories/{id} {
      allow read, write: if signedIn();
    }

    match /locations/{id} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.ownerId);
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    // Published products are visible to everyone (B2B marketplace); drafts are owner-only.
    match /products/{id} {
      allow read: if signedIn() && (resource.data.isPublished == true || isOwner(resource.data.ownerId));
      allow create: if isOwner(request.resource.data.ownerId);
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    match /recipes/{id} {
      allow read, write: if isOwner(resource.data.ownerId)
        || (request.method == 'create' && isOwner(request.resource.data.ownerId));
    }

    match /pos_sales/{id} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId);
    }

    match /khata/{id} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId);
    }

    // Recommended: denormalize an `ownerId` field onto stock docs for tight rules.
    match /stock/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (!('ownerId' in request.resource.data) || isOwner(request.resource.data.ownerId));
      allow update, delete: if signedIn() && (!('ownerId' in resource.data) || isOwner(resource.data.ownerId));
    }

    // Orders link a buyer and a seller; both may read/update, neither may hard-delete.
    match /orders/{id} {
      allow read: if signedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow create: if signedIn() && request.auth.uid == request.resource.data.buyerId;
      allow update: if signedIn() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow delete: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

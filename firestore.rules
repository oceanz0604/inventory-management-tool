rules_version = '2';

// Security rules for ZatPat IMS Firestore data.
//
// AUTH MODEL (important): Company users (owners + office/staff/marketing) sign in
// with a username + password that is stored in the `users` collection and matched
// CLIENT-SIDE (see js/auth.js + js/creds.js). They do NOT use Firebase Auth, so
// their requests are UNAUTHENTICATED. As a result the company data collections are
// open for read/write — the login screen is a client-side gate, not a server-side
// guarantee. Only the super admin (admin.html) uses Firebase Auth.
//
// Passwords are never stored in plaintext (per-user salt + SHA-256), but note that
// the salted hashes live in `users` and are world-readable under this model.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'yashtodkar2@gmail.com';
    }

    // Company-scoped collections used by the client app (unauthenticated).
    match /companies/{id}  { allow read, write: if true; }
    match /users/{id}      { allow read, write: if true; }
    match /categories/{id} { allow read, write: if true; }
    match /locations/{id}  { allow read, write: if true; }
    match /products/{id}   { allow read, write: if true; }
    match /stock/{id}      { allow read, write: if true; }
    match /batches/{id}    { allow read, write: if true; }
    match /orders/{id}     { allow read, write: if true; }
    match /recipes/{id}    { allow read, write: if true; }
    match /pos_sales/{id}  { allow read, write: if true; }
    match /khata/{id}      { allow read, write: if true; }
    match /parties/{id}    { allow read, write: if true; }

    // Anything else (e.g. internal/meta docs): super admin only.
    match /{document=**} { allow read, write: if isAdmin(); }
  }
}
